{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fpa-saas-platform",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": {
    "command": "bun run build"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
